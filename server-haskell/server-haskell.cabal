cabal-version:      2.4
name:                server-haskell
version:             0.1.0.0

executable server-haskell
    main-is:          Main.hs
    other-modules:    Tree, TreeError, Dto, Api
    hs-source-dirs:   app, src
    build-depends:    base, scotty, aeson, text, wai, wai-cors, http-types
    default-language: Haskell2010
    ghc-options:      -threaded